# Backend-only OpenAI configuration for local development.
# Copy to env/.env.local or run `npm run setup:openai`.
#
# OPENAI_API_KEY must only be read by server/API-route code.
# Never expose this key through frontend public env prefixes such as:
# NEXT_PUBLIC_, VITE_, EXPO_PUBLIC_, or REACT_APP_.
OPENAI_API_KEY=

# Scanner backend controls.
SCANNER_AI_PROVIDER=openai
SCANNER_MAX_IMAGE_MB=4
SCANNER_RATE_LIMIT_PER_MINUTE=10
