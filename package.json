{
  "name": "strainspotter-web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "setup:openai": "node scripts/setup-openai-key.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:embeddings": "node scripts/build-embedding-dataset.mjs",
