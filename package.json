    "cap:prep": "node scripts/prepare-capacitor-webdir.mjs",
    "cap:sync": "npm run cap:prep && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "tauri": "tauri",
