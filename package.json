    "next": "^16.1.1",
    "openai": "^6.35.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^17.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^20.19.28",
    "@types/react": "^18.3.27",
    "autoprefixer": "^10.4.23",
