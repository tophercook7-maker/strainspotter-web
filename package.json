    "@capacitor/ios": "8.3.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/analytics": "^2.0.1",
