    "dataset:prefilter": "node scripts/prefilter-vault-dataset.mjs",
    "dataset:review": "node scripts/review-dataset-manifest.mjs --manifest data/review-manifest.json",
    "data:move-to-vault": "node scripts/move-data-to-vault.mjs",
    "dataset:scrape": "node scripts/scrape-allowlisted-sources.mjs",
    "catalog:normalize": "node scripts/normalize-strain-catalog.mjs",
