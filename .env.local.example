# Copy to .env.local and fill in real values. Do not commit .env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Backend-only OpenAI key for /api/scan. Never expose secrets through frontend
# prefixes such as NEXT_PUBLIC_, VITE_, EXPO_PUBLIC_, or REACT_APP_.
OPENAI_API_KEY=
SCANNER_AI_PROVIDER=openai
SCANNER_MAX_IMAGE_MB=4
SCANNER_RATE_LIMIT_PER_MINUTE=10
OPENAI_SCAN_MODEL=gpt-4o-mini

# Backend base URL for scan processing (e.g. http://localhost:5181 or https://<backend-domain>)
NEXT_PUBLIC_API_BASE=

# Garden Console ingest: shared secret for POST /api/garden/console/ingest (header: x-ingest-key). Production denies if unset.
GARDEN_CONSOLE_INGEST_KEY=

# Local Data Engine storage. Copy this into .env.local when TheVault is mounted.
STRAINSPOTTER_DATA_ROOT=/Volumes/TheVault/StrainSpotterData
DATA_ENGINE_DATA_ROOT=/Volumes/TheVault/StrainSpotterData
