# OpenAI (backend-only; required for /api/scan when SCANNER_AI_PROVIDER=openai)
# Never expose this key through frontend public env prefixes such as
# NEXT_PUBLIC_, VITE_, EXPO_PUBLIC_, or REACT_APP_.
OPENAI_API_KEY=

# Vision model id — pin to a dated snapshot for reproducible behavior.
# Default in code: gpt-4o-mini
OPENAI_SCAN_MODEL=gpt-4o-mini

# Server-side scanner controls.
SCANNER_AI_PROVIDER=openai
SCANNER_MAX_IMAGE_MB=4
SCANNER_RATE_LIMIT_PER_MINUTE=10

# Client-side scanner: center-crop extreme aspect ratios toward 4:3 / 3:4 before resize.
# Set to "false" to disable (must be NEXT_PUBLIC_ for browser bundles).
NEXT_PUBLIC_SCANNER_CENTER_CROP=true

# Optional: absolute origin for browser-side `/api/*` fetches (Capacitor file/ custom scheme, or split API host).
# Leave empty for normal Vercel / same-origin web deploys at strainspotter.com.
# Example for native shells calling production APIs: https://strainspotter.com
NEXT_PUBLIC_API_BASE_URL=
